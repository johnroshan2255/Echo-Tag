# Production Colyseus server (Railway). Vite loads this on top of .env for `vite build`,
# so dev keeps localhost while every packaged zip talks to the deployed server over wss.
# Rotate here if the server moves; then `npm run package:crazygames` / `package:web`.
VITE_WS_ORIGIN=wss://echo-tag-production.up.railway.app
